auto tag_invoke(deserialize_tag, ondemand::value& val,Key& payload){
    std::string_view value;

    auto error = val.get_string().get(value);
    if (error) {
        return error;
    }

    if (value == "Unknown") {
        payload = Key::Unknown;
        return simdjson::SUCCESS;
    }
    if (value == "Return") {
        payload = Key::Return;
        return simdjson::SUCCESS;
    }
    if (value == "Escape") {
        payload = Key::Escape;
        return simdjson::SUCCESS;
    }
    if (value == "Backspace") {
        payload = Key::Backspace;
        return simdjson::SUCCESS;
    }
    if (value == "Tab") {
        payload = Key::Tab;
        return simdjson::SUCCESS;
    }
    if (value == "Space") {
        payload = Key::Space;
        return simdjson::SUCCESS;
    }
    if (value == "Exclaim") {
        payload = Key::Exclaim;
        return simdjson::SUCCESS;
    }
    if (value == "Dblapostrophe") {
        payload = Key::Dblapostrophe;
