{
	"version": 4,
	"configurePresets": [
		{
			"name": "default",
			"binaryDir": "${sourceDir}/build",
			"generator": "Ninja",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CMAKE_INSTALL_PREFIX": "install"
			}
		},
		{
			"name": "gcc",
			"displayName": "GNU GCC",
			"inherits": "default",

			"cacheVariables": {
				"CMAKE_C_COMPILER": "gcc",
				"CMAKE_CXX_COMPILER": "g++"
			}
		},
		{
			"name": "clang",
			"displayName": "LLVM Clang",
			"inherits": "default",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "clang",
				"CMAKE_CXX_COMPILER": "clang++"
			}
		},
		{
			"name": "msvc",
			"displayName": "MSVC",
			"inherits": "default",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "cl",
				"CMAKE_CXX_COMPILER": "cl"
			}
		}
	]
}
